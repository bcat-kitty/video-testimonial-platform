# ---------------------------------------------------------------------------
# Debrief runs with ZERO configuration in demo mode.
# Copy this file to .env.local and fill in only what you need.
# ---------------------------------------------------------------------------

# Public URL of this instance. Used to build the recording links you email out.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (required to keep anything) ----------------------------------
# Any Postgres connection string: Neon, Supabase, RDS, local, whatever.
# Leave empty and Debrief runs on in-memory demo data instead.
DATABASE_URL=

# --- Storage (required for real video uploads) -----------------------------
# Vercel Blob token, for storing the recorded videos and photos.
# Leave empty and video upload is disabled (text testimonials still work).
BLOB_READ_WRITE_TOKEN=

# --- Admin (required in production) ----------------------------------------
# The password for /admin. If unset, the admin page is open in dev and
# locked entirely in production.
ADMIN_PASSWORD=

# --- Email (optional) ------------------------------------------------------
# Without this, Debrief still creates request links, it just hands them to you
# to send yourself instead of emailing them.
RESEND_API_KEY=
EMAIL_FROM="Your Name <you@yourdomain.com>"
# Where the "new testimonial came in" notification goes.
EMAIL_NOTIFY=you@yourdomain.com

# --- AI (optional) ---------------------------------------------------------
# Transcribes the video (Whisper) and turns it into a written testimonial.
# Without this, videos are stored and played back as-is, with no text.
OPENAI_API_KEY=

# --- Cron (optional) -------------------------------------------------------
# Shared secret for GET /api/cron/nudges, which re-sends unanswered requests.
CRON_SECRET=
